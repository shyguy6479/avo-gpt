    "@splinetool/runtime": "^1.12.98",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
